TOOL=esbmc
SOURCES="harness.cpp hmac_model.cpp $ROOT/src/remote_cmd.cpp"
CFLAGS="-I$ROOT/src -Ishim -DNATIVE_BUILD=1 -DDIRECT -DMUT_NOAUTH"
FLAGS="--unwind 110"
EXPECT=fail
CHECKS="opposite property: dispatch only when HMAC never ran -> must fail"
EXPECT_PROP='assertion g_m.hmac_calls == 0$'
TIMEOUT=2400
