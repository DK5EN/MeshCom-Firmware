TOOL=esbmc
SOURCES="harness.cpp hmac_model.cpp $ROOT/src/remote_cmd.cpp"
CFLAGS="-I$ROOT/src -Ishim -DNATIVE_BUILD=1 -DDIRECT -DROUNDS=2"
FLAGS="--unwind 110"
EXPECT=pass
CHECKS="rmCheck over any RmCmd (all bytes nondet), nondet secret/sender/state: memory safety, two rounds on one state: dispatch => HMAC verified, an executed frame is never executed twice (replay)"
TIMEOUT=2400
# cost unmeasured, two rmCheck rounds
TIER=heavy
