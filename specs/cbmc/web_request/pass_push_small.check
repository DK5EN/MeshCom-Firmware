TOOL=esbmc
SOURCES="harness.cpp"
CFLAGS="-I$ROOT/src/web_functions -DWEB_HEAD_MAX=8 -DWEB_COOKIE_MAX=3 -DM_PUSH_SMALL -DSTREAM=10"
FLAGS="--unwind 12"
EXPECT=pass
CHECKS="webHeadPush: 10 symbolic bytes, WEB_HEAD_MAX=8: no OOB, head/line/cookie_len within caps, NUL terminators, sticky after DONE/TOO_BIG, wipe on TOO_BIG"
