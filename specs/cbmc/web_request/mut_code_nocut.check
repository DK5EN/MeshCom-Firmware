TOOL=esbmc
# code mutation: the "cut mid-line by the window" break is removed from a COPY of the header (WEB_HEAD_MAX=4)
G=gen/mut_code_nocut; mkdir -p $G
sed 's/if (!terminated \&\& len >= (size_t)WEB_HEAD_MAX)/if (0)/' "$ROOT/src/web_functions/web_request.h" > $G/web_request.h
cmp -s "$ROOT/src/web_functions/web_request.h" $G/web_request.h && { echo "  mutation did not apply to web_request.h (source changed?)"; TOOL=none; }
SOURCES="harness.cpp"
CFLAGS="-I$G -I$ROOT/src/web_functions -DWEB_HEAD_MAX=4 -DWEB_COOKIE_MAX=6 -DM_PARSE_ANY -DPLEN=6 -DPMIN=1 -DLEAD_LF -DALPHA=AL_CLAMP -DNOHDR -DMODEL_BLANK"
FLAGS="--unwind 9"
EXPECT=fail
CHECKS="code mutation: the cut-line break removed -> a lone CR cut by the full window is judged as a blank line (blank differs from the reference)"
EXPECT_PROP='^  assertion '
