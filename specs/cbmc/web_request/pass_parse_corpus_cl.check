TOOL=esbmc
SOURCES="harness.cpp"
CFLAGS="-I$ROOT/src/web_functions -DWEB_HEAD_MAX=64 -DWEB_COOKIE_MAX=6 -DM_PARSE_CORPUS -DCORPUS=3 -DPLEN=64 -DPLEN_MAX=64"
FLAGS="--unwind 72"
EXPECT=pass
CHECKS="webReqParse concrete corpus 3 (Content-Length strict judgement: value forms, 65535/65536, overflow, duplicates equal and differing, name with a blank, bad request line wins, line cut by the full window): all fields of WebReq equal the stated values (enumeration of 24 constant inputs, not a symbolic class)"
