TOOL=esbmc
SOURCES="harness.cpp"
CFLAGS="-I$ROOT/src/web_functions -DWEB_HEAD_MAX=16 -DWEB_COOKIE_MAX=5 -DM_PUSH_COOKIE"
FLAGS="--unwind 18"
EXPECT=pass
CHECKS="cookie capture, 8 symbolic bytes (NUL allowed, not CR/LF): only a mcs= preceded by ':' ' ' or ';' (index >= 7) that ends before the first NUL at or after index 7, first match wins, copy up to ';' or WEB_COOKIE_MAX (NUL bytes copied); equals a reference model, never beyond cookie[]"
