TOOL=esbmc
# code mutation: the predecessor test of the mcs= search (':' ' ' ';') is removed in a COPY of the header
G=gen/mut_code_cookiepred; mkdir -p $G
sed "s/(a->line\[k - 1\] == ':' || a->line\[k - 1\] == ' ' || a->line\[k - 1\] == ';')/1/" "$ROOT/src/web_functions/web_request.h" > $G/web_request.h
cmp -s "$ROOT/src/web_functions/web_request.h" $G/web_request.h && { echo "  mutation did not apply to web_request.h (source changed?)"; TOOL=none; }
SOURCES="harness.cpp"
CFLAGS="-I$G -I$ROOT/src/web_functions -DWEB_HEAD_MAX=16 -DWEB_COOKIE_MAX=5 -DM_PUSH_COOKIE"
FLAGS="--unwind 18"
EXPECT=fail
CHECKS="code mutation: predecessor test removed -> xmcs=... is captured (cookie differs from the reference)"
EXPECT_PROP='^  assertion '
