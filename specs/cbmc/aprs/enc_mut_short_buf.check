TOOL=esbmc
SOURCES="enc_harness.cpp $ROOT/src/charset_filter.cpp"
CFLAGS="-Istubs -I$ROOT/test/support -I$ROOT/src -DNATIVE_BUILD=1 -DUNIT_TEST=1 -DMUT_SHORT_BUF"
FLAGS="--no-unwinding-assertions --unwind 260"
EXPECT=fail
CHECKS="mutation enc_mut_short_buf (encodeStartAPRS target one byte short)"
EXPECT_PROP='dereference failure|upper bound|out of bounds|array bounds'
