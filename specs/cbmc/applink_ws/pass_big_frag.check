# PARKED 2026-11-23 (not run by --all): 4 and 2 onData calls both exceeded the 6 GB cap (25 GB unguarded),
# nested alWsFeed loops 379 x 477 under symbolic L2. Needs a rebuilt harness with concrete lengths, one job per case.
TOOL=esbmc
SOURCES="harness.cpp $ROOT/src/applink_ws.cpp"
CFLAGS="-I$ROOT/src -DMODE_BIG -DBIG_FIXED -DBIG_COARSE -DBIGCALLS=2 -DL2MIN=150 -DL2MAX=151"
FLAGS="--unwind 170 --unwindset 18:16"
EXPECT=pass
CHECKS="BIN(FIN=0,150)+CONT(150..151 = 300 / 301), one chunk per frame (2 calls), unwind 170: reassembly limit at 300, no overrun"
TIMEOUT=1800
# memout at the 6 GB cap on 2026-11-23: unrolls a 300-byte payload loop. Small-scope twin: pass_cap_small.check
TIER=heavy
