JOB=mut_code_nomax
TOOL=esbmc
# Library under test: NimBLE-Arduino 2.2.3 ble_att_svr.c of the ESP32 env heltec_wifi_lora_32_V3 (never modified).
LIB="$ROOT/.pio/libdeps/heltec_wifi_lora_32_V3/NimBLE-Arduino/src"
SRC="$LIB/nimble/nimble/host/src/ble_att_svr.c"
[ -f "$SRC" ] || { echo "  NimBLE library missing under .pio/libdeps (run pio run -e heltec_wifi_lora_32_V3)"; TOOL=none; }
G=gen/$JOB; mkdir -p $G
# prepare/execute queue: from "static void ble_att_svr_prep_free" up to (not including) "int ble_att_svr_rx_notify"
S=$(grep -n '^ble_att_svr_prep_free(' "$SRC" | head -1 | cut -d: -f1); E=$(grep -n '^ble_att_svr_rx_notify(' "$SRC" | head -1 | cut -d: -f1)
sed -n "$((S - 1)),$((E - 3))p" "$SRC" > $G/orig.inc
[ "$(wc -l < $G/orig.inc)" -gt 400 ] && [ "$(wc -l < $G/orig.inc)" -lt 470 ] || { echo "  prepare queue extraction failed (anchor changed?)"; TOOL=none; }
for FN in prep_free prep_alloc prep_find_prev prep_clear prep_validate prep_extract prep_write insert_prep_entry rx_prep_write rx_exec_write; do
  [ "$(grep -c "^ble_att_svr_$FN(" $G/orig.inc)" = 1 ] || { echo "  function $FN missing in extraction"; TOOL=none; }
done
sed "s/if (cur_len > BLE_ATT_ATTR_MAX_LEN) {/if (0) {/" $G/orig.inc > $G/prep_part.inc
cmp -s $G/orig.inc $G/prep_part.inc && { echo "  mutation did not apply (anchor changed?)"; TOOL=none; }
SOURCES="harness.c"
CFLAGS="-I$G -Istubs -DNPREP=2 -DLEN=2 -DBLE_ATT_ATTR_MAX_LEN=3 -DH_LO=1 -DH_HI=1 -DO_LO=0 -DO_HI=3 -DL_LO=0 -DL_HI=2"
FLAGS="--unwind 4"
EXPECT=fail
CHECKS="code mutation (config of pass_prep_exec_off): max-length check of prep_validate removed -> over-max value delivered"
EXPECT_PROP='^  assertion '
