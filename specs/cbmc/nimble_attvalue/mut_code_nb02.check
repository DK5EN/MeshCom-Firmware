TOOL=esbmc
# Library under test: the patched NimBLE-Arduino 2.2.3 copy of the ESP32 env used by heltec_wifi_lora_32_V3
# (platformio.ini lib_deps; the other ESP32 envs resolve to the same version and patch set, tools/nimble_patch.py).
# Run `pio run -e heltec_wifi_lora_32_V3` once so .pio/libdeps holds the patched copy (NB-01, NB-02).
LIB="$ROOT/.pio/libdeps/heltec_wifi_lora_32_V3/NimBLE-Arduino/src"
[ -f "$LIB/NimBLEAttValue.cpp" ] || { echo "  NimBLE library missing under .pio/libdeps (run pio run -e heltec_wifi_lora_32_V3)"; TOOL=none; }
INC="-Istubs -Istubs/nimble -I$LIB -I$ROOT/src -DCONFIG_NIMBLE_CPP_LOG_LEVEL=0 -DCONFIG_BT_ENABLED"
mkdir -p gen/nb02 && sed "s|bool grow = new_len > m_capacity; /\* MESHCOM-PATCH NB-02 \*/|bool grow = new_len > m_capacity; if (grow) m_capacity = new_len;|" "$LIB/NimBLEAttValue.cpp" > gen/nb02/attvalue_impl.cpp
cmp -s "$LIB/NimBLEAttValue.cpp" gen/nb02/attvalue_impl.cpp && { echo "  mutation did not apply (NB-02 anchor changed?)"; TOOL=none; }
G=gen/nb02
SOURCES="harness.cpp"
CFLAGS="-I$G $INC -DMAXLEN=24 -DWLEN=28 -DNOPS=2 -DMODE_SETAPP"
FLAGS="--unwind 32"
EXPECT=fail
CHECKS="code mutation: NB-02 reverted (capacity raised before realloc) -> second write past the block after a failed grow"
EXPECT_PROP="dereference failure|upper bound|out of bounds|array bounds|invalid pointer|memcpy"
