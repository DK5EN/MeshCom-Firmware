TOOL=esbmc
# Library under test: the patched NimBLE-Arduino 2.2.3 copy of the ESP32 env used by heltec_wifi_lora_32_V3
# (platformio.ini lib_deps; the other ESP32 envs resolve to the same version and patch set, tools/nimble_patch.py).
# Run `pio run -e heltec_wifi_lora_32_V3` once so .pio/libdeps holds the patched copy (NB-01, NB-02).
LIB="$ROOT/.pio/libdeps/heltec_wifi_lora_32_V3/NimBLE-Arduino/src"
[ -f "$LIB/NimBLEAttValue.cpp" ] || { echo "  NimBLE library missing under .pio/libdeps (run pio run -e heltec_wifi_lora_32_V3)"; TOOL=none; }
INC="-Istubs -Istubs/nimble -I$LIB -I$ROOT/src -DCONFIG_NIMBLE_CPP_LOG_LEVEL=0 -DCONFIG_BT_ENABLED"
G=gen/lib; mkdir -p $G && cp "$LIB/NimBLEAttValue.cpp" $G/attvalue_impl.cpp   # the library source, #included by harness.cpp
SOURCES="harness.cpp"
CFLAGS="-I$G $INC -DMAX_MSG_LEN_PHONE=24 -DMAXLEN=24 -DWLEN=28 -DMODE_SEAM"
FLAGS="--unwind 40"
EXPECT=pass
CHECKS="bleItemFromWrite over the real NimBLEAttValue copy: no NULL/short read, length 1..cap, failed copy never queued; cap reduced to 24 (MAX_MSG_LEN_PHONE=24), len 0..28, alloc may fail; the 300 B case was over 900 s"
