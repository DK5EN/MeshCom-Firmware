# Copy to .env (gitignored), then: chmod 600 .env
# Read by tools/mc_console.py for every net console (2323) client.
#
# One line per node: MC_PW_<CALL> with the dash as underscore. The value is the
# node's --passwd (console 2323, KISS auth, remote management; max. 14 chars).
# A node without a password needs no line.
#
# Web GUI password (--webpwd, used by tools/webflash.py for OTA): MC_WEBPW_<CALL>.
# Falls back to MC_PW_<CALL> when absent, so one shared password needs no extra line.
# MC_WEBPW_DK5EN_1=
#
# MC_CONSOLE_PW in the environment overrides the lookup for one run;
# MC_ENV_FILE points to a different file (e.g. on the rpizero).
MC_PW_DK5EN_1=
MC_PW_DK5EN_90=
MC_PW_DK5EN_92=
